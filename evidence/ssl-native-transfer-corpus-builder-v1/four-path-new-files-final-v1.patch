+IMPLEMENTER = "01a0ef20-7397-7ba1-a98c-f59bc38ddcc1"
+EVIDENCE = "REVIEWED_NATIVE_NUMERIC_MATERIALIZATION"
+RAM_LIMIT = 22 * 1024**3
+RESOURCE_POLICY = {
+    "device": "cpu",
+    "owned_tree_rss_limit_bytes": RAM_LIMIT,
+    "single_owned_process": True,
