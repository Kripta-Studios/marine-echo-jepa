+def array_descriptor(value):
+    return {
+        "dtype": value.dtype.str,
+        "shape": list(value.shape),
+        "content_sha256": sha(np.ascontiguousarray(value).tobytes()),
+        "encoding": "numpy_C_order_bytes",
+    }
