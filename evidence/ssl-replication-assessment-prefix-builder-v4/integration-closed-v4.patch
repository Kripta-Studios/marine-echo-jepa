+    # this child starts. Perform the complete immutable metadata gate directly;
+    # prelaunch's fresh-receipt/idle-ledger checks belong to the parent only.
+    from execute_bounded_native_replication_assessment import (
+        LEDGER,
+        OWNER,
+        _policy,
+        admit,
+        read_json,
+    )
