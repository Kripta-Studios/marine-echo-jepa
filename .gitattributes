* text=auto
*.md text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.png binary
*.zip binary

# Preserve exact bytes for hash-addressed execution evidence and signed review records.
evidence/continuation/** -text whitespace=-blank-at-eol,-blank-at-eof
evidence/v2/** -text whitespace=-blank-at-eol,-blank-at-eof
evidence/v2-execution/** -text whitespace=-blank-at-eol,-blank-at-eof
reports/v2/** -text whitespace=-blank-at-eol,-blank-at-eof
orchestration/reviews/** -text whitespace=cr-at-eol
# This already executed Windows source is frozen by the census identity.
tools/train_census.py -text whitespace=cr-at-eol

# Retain historical registry/checkpoint bytes under their SHA-256 filenames.
reports/active/report-versions/** -text whitespace=cr-at-eol
orchestration/report-versions/** -text whitespace=cr-at-eol
