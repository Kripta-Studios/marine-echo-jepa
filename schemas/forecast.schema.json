{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marine-echo:forecast:1.0",
  "title": "Forecast response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "domain",
    "data_kind",
    "mode",
    "prediction_cutoff",
    "last_observation_at",
    "observation_age_hours",
    "range_convention",
    "calibrated",
    "units",
    "support_fraction",
    "status",
    "reasons",
    "model_id",
    "checkpoint_sha256",
    "preprocessing_sha256",
    "split_sha256",
    "evidence_id",
    "scope_disclaimer",
    "forecasts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "data_kind": {
      "enum": [
        "public_real",
        "synthetic_fixture"
      ]
    },
    "mode": {
      "enum": [
        "live_cpu",
        "cached_replay",
        "synthetic_fixture"
      ]
    },
    "prediction_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "last_observation_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "observation_age_hours": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "range_convention": {
      "enum": [
        "range_from_transducer_m",
        "verified_depth_m"
      ]
    },
    "calibrated": {
      "type": "boolean"
    },
    "units": {
      "enum": [
        "dB re 1 m^-1",
        "relative_dB",
        "synthetic_dB"
      ]
    },
    "support_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "enum": [
        "ok",
        "abstained"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "preprocessing_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "split_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "scope_disclaimer": {
      "type": "string",
      "minLength": 20
    },
    "forecasts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "horizon_hours",
          "target_start",
          "target_end",
          "quantiles"
        ],
        "properties": {
          "horizon_hours": {
            "enum": [
              1,
              3,
              6
            ]
          },
          "target_start": {
            "type": "string",
            "format": "date-time"
          },
          "target_end": {
            "type": "string",
            "format": "date-time"
          },
          "quantiles": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "0.05",
              "0.25",
              "0.5",
              "0.75",
              "0.95"
            ],
            "properties": {
              "0.05": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "0.25": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "0.5": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "0.75": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "0.95": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  },
  "$comment": "Also enforce unique horizons, monotone finite quantiles, status/null consistency, correct target windows, provenance and cutoff semantics in Python. JSON schema alone is insufficient."
}
